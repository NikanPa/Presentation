SELECT 
    Customers.CustFirstName, 
    Customers.CustLastName, 
    Customers.CustCity,
    Customers.CustState,
    COUNT(Orders.OrderNumber) AS TotalOrders
FROM Customers
JOIN Orders 
    ON Customers.CustomerID = Orders.CustomerID
GROUP BY 
    Customers.CustFirstName, 
    Customers.CustLastName,
    Customers.CustCity,
    Customers.CustState
ORDER BY 
    TotalOrders DESC
LIMIT 5;

SELECT 
    Products.ProductName, 
    SUM(Order_Details.QuantityOrdered * Order_Details.QuotedPrice) AS TotalRevenue
FROM Products
JOIN Order_Details 
    ON Products.ProductNumber = Order_Details.ProductNumber
GROUP BY 
    Products.ProductName
ORDER BY 
    TotalRevenue DESC
LIMIT 5;
